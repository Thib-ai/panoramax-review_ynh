# Environment file for Panoramax Review
# shellcheck disable=SC2034
# NOTE: NODE_ENV is intentionally NOT set here. Vite refuses
# NODE_ENV=production in a .env file, and the kept .env would be
# present during `npm run build` on upgrades, causing a warning.
# NODE_ENV=production is set in the systemd unit instead.

PORT=__PORT__
DATA_DIR=__DATA_DIR__
